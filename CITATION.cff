message: "If you use these results, please cite this work."
title: "Quantum Stochastic Inflation"
authors:
  - family-names: "Christie"
    given-names: "Robson"
  - family-names: "Joo"
    given-names: "Jaewoo"
  - family-names: "Kaplanek"
    given-names: "Greg"
  - family-names: "Vennin"
    given-names: "Vincent"
  - family-names: "Wands"
    given-names: "David"
abstract: "We formulate stochastic inflation in an open quantum system framework, deriving a one-channel GKLS dynamics for the coarse-grained canonical bulk variables and recovering the stochastic-inflation Fokker-Planck description through the Wigner-Weyl transform."
keywords:
  - "stochastic inflation"
  - "quantum stochastic inflation"
  - "open quantum systems"
  - "de Sitter space"
  - "quantum fields in curved spacetime"
  - "canonical coarse graining"
  - "GKLS equation"
  - "Lindblad dynamics"
  - "Wigner function"
  - "Fokker-Planck equation"
  - "Langevin equation"
  - "quantum-to-classical transition"
  - "inflationary perturbations"
repository-code: "https://github.com/rchristie95/QuantumStochasticInflation"
url: "https://arxiv.org/abs/2606.12636"
doi: "10.48550/arXiv.2606.12636"
license: "CC-BY-4.0"
date-released: "2026-06-10"
