     "rho", " ", "|", " ", "Lop", " ", "|", " ", "Ldag", " ", "|", " ", "Kop",
       " ", "|", " ", "Id", " ", "|", " ", "NonCommutativeMultiply"}]}], 
    "]"}]}], ";"}], "\n", 
