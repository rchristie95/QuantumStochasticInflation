\>", "Section",ExpressionUUID->"3ded6e27-e11f-af41-80f8-204f4e3554f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"KossakowskiQPFromEll", "[", 
    RowBox[{
    "ellQv_", ",", " ", "ellPv_", ",", " ", "ellQbv_", ",", " ", "ellPbv_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ellQv", " ", "ellQbv"}], ",", " ", 
       RowBox[{"ellQv", " ", "ellPbv"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ellPv", " ", "ellQbv"}], ",", " ", 
       RowBox[{"ellPv", " ", "ellPbv"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"KossakowskiQPFromRules", "[", "rules_", "]"}], " ", ":=", " ", 
   RowBox[{"KossakowskiQPFromEll", "[", 
    RowBox[{
     RowBox[{"ellQ", " ", "/.", " ", "rules"}], ",", " ", 
     RowBox[{"ellP", " ", "/.", " ", "rules"}], ",", " ", 
     RowBox[{"ellQBar", " ", "/.", " ", "rules"}], ",", " ", 
     RowBox[{"ellPBar", " ", "/.", " ", "rules"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"KossakowskiRealSymmetricPart", "[", "Kmat_", "]"}], " ", ":=", 
   " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Kmat", " ", "+", " ", 
        RowBox[{"Transpose", "[", "Kmat", "]"}]}], ")"}], "/", "2"}], ",", 
     " ", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DiffusionFromKossakowski", "[", "Kmat_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Omega", " ", ".", " ", 
      RowBox[{"KossakowskiRealSymmetricPart", "[", "Kmat", "]"}], " ", ".", 
      " ", 
      RowBox[{"Transpose", "[", "Omega", "]"}]}], ",", " ", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"KossakowskiGeneralMode", " ", "=", " ", 
   RowBox[{"KossakowskiQPFromRules", "[", "coeffModeFunctions", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"KossakowskiMassless", " ", "=", " ", 
   RowBox[{"KossakowskiQPFromRules", "[", "coeffMassless", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"KossakowskiDiffusionGeneralCheck", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DFromRules", "[", "coeffModeFunctions", "]"}], " ", "-", " ", 
      RowBox[{
      "DiffusionFromKossakowski", "[", "KossakowskiGeneralMode", "]"}]}], ",",
      " ", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"KossakowskiDiffusionMasslessCheck", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DFromRules", "[", "coeffMassless", "]"}], " ", "-", " ", 
      RowBox[{"DiffusionFromKossakowski", "[", "KossakowskiMassless", "]"}]}],
      ",", " ", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
