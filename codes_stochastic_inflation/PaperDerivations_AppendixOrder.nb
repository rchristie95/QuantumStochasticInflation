Cell["Appendix C: Wigner Dynamics and Purity", "Section",ExpressionUUID->"f0517606-c7c2-444c-bc27-a7f492bd5b3c"],

Cell[CellGroupData[{

Cell["General mode-function coefficients", "Subsection",ExpressionUUID->"23cf8eb7-a0be-c24c-95ee-f4fea0e35290"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "W", ",", "Wfun", ",", "q1", ",", "p1", ",", "q2", ",", "p2", ",", "hbar", 
    ",", "moyalOrder"}], "]"}], ";", 
  RowBox[{"moyalOrder", "=", "4"}], ";", 
  RowBox[{"Wfun", "=", 
   RowBox[{"W", "[", 
    RowBox[{"q", ",", "p"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"PoissonOp", "[", "expr_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"\[ImaginaryI]", " ", "hbar"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"q1", ",", "p2"}]], "expr"}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"p1", ",", "q2"}]], "expr"}]}], ")"}]}]}], ";", 
  RowBox[{
   RowBox[{
    RowBox[{"PoisPower", "[", "n_", "]"}], "[", "expr_", "]"}], ":=", 
   RowBox[{"Nest", "[", 
    RowBox[{"PoissonOp", ",", "expr", ",", "n"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Moyal", "[", 
    RowBox[{"A_", ",", "B_", ",", 
     RowBox[{"trunc_", ":", "moyalOrder"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "expr", "}"}], ",", 
     RowBox[{
      RowBox[{"expr", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A", "/.", "\[VeryThinSpace]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "\[Rule]", "q1"}], ",", 
            RowBox[{"p", "\[Rule]", "p1"}]}], "}"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"B", "/.", "\[VeryThinSpace]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "\[Rule]", "q2"}], ",", 
            RowBox[{"p", "\[Rule]", "p2"}]}], "}"}]}], ")"}]}]}], ";", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "trunc"], 
        FractionBox[
         RowBox[{
          RowBox[{"PoisPower", "[", "n", "]"}], "[", "expr", "]"}], 
         RowBox[{"n", "!"}]]}], "/.", "\[VeryThinSpace]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q1", "\[Rule]", "q"}], ",", 
         RowBox[{"p1", "\[Rule]", "p"}], ",", 
         RowBox[{"q2", "\[Rule]", "q"}], ",", 
         RowBox[{"p2", "\[Rule]", "p"}]}], "}"}]}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Comm", "[", 
    RowBox[{"A_", ",", "B_", ",", 
     RowBox[{"trunc_", ":", "moyalOrder"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Moyal", "[", 
     RowBox[{"A", ",", "B", ",", "trunc"}], "]"}], "-", 
    RowBox[{"Moyal", "[", 
     RowBox[{"B", ",", "A", ",", "trunc"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"LWeyl", "[", 
    RowBox[{"rules_", ":", 
     RowBox[{"{", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"ellQ", " ", "q"}], "+", 
     RowBox[{"ellP", " ", "p"}]}], "/.", "\[VeryThinSpace]", "rules"}]}], ";", 
  RowBox[{
   RowBox[{"LDagWeyl", "[", 
    RowBox[{"rules_", ":", 
     RowBox[{"{", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"ellQBar", " ", "q"}], "+", 
     RowBox[{"ellPBar", " ", "p"}]}], "/.", "\[VeryThinSpace]", "rules"}]}], ";", 
  RowBox[{
   RowBox[{"LindbladGenerator", "[", 
    RowBox[{
     RowBox[{"rules_", ":", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"trunc_", ":", "moyalOrder"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "=", 
        RowBox[{"LWeyl", "[", "rules", "]"}]}], ",", 
       RowBox[{"Ld", "=", 
        RowBox[{"LDagWeyl", "[", "rules", "]"}]}], ",", "ham", ",", "diss"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"ham", "=", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Comm", "[", 
           RowBox[{
            RowBox[{"KeffWeyl", "/.", "\[VeryThinSpace]", "rules"}], ",", 
            "Wfun", ",", "trunc"}], "]"}]}], "hbar"]}]}], ";", 
      RowBox[{"diss", "=", 
       RowBox[{
        RowBox[{"Moyal", "[", 
         RowBox[{
          RowBox[{"Moyal", "[", 
           RowBox[{"L", ",", "Wfun", ",", "trunc"}], "]"}], ",", "Ld", ",", 
          "trunc"}], "]"}], "-", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"Moyal", "[", 
          RowBox[{
           RowBox[{"Moyal", "[", 
            RowBox[{"Ld", ",", "L", ",", "trunc"}], "]"}], ",", "Wfun", ",", 
           "trunc"}], "]"}]}], "-", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"Moyal", "[", 
          RowBox[{"Wfun", ",", 
           RowBox[{"Moyal", "[", 
            RowBox[{"Ld", ",", "L", ",", "trunc"}], "]"}], ",", "trunc"}], 
          "]"}]}]}]}], ";", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ham", "+", "diss"}], "/.", "\[VeryThinSpace]", 
         RowBox[{"hbar", "\[Rule]", "1"}]}], ",", 
        RowBox[{"assume", "[", 
         RowBox[{"mass", "\[GreaterEqual]", "0"}], "]"}]}], "]"}]}]}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"collectW", "[", "expr_", "]"}], ":=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Expand", "[", "expr", "]"}], ",", 
     RowBox[{"{", 
