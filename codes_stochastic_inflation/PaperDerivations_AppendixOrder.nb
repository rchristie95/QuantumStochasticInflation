Cell[BoxData[
 RowBox[{
  RowBox[{"wronskianRule", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"phiMode", " ", "piBar"}], "-", 
     RowBox[{"phiBar", " ", "piMode"}]}], "\[Rule]", "\[ImaginaryI]"}]}], ";", 
  RowBox[{"canonicalCommutatorCheck", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"phiMode", " ", "piBar"}], "-", 
      RowBox[{"phiBar", " ", "piMode"}]}], "/.", "\[VeryThinSpace]", 
     "wronskianRule"}], "]"}]}], ";", 
  RowBox[{"bulkModeExpansion", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<Q\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"phiMode", " ", "a"}], "+", 
       RowBox[{"phiBar", " ", "adag"}]}]}], ",", 
     RowBox[{"\"\<P\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"piMode", " ", "a"}], "+", 
       RowBox[{"piBar", " ", "adag"}]}]}], ",", 
     RowBox[{"\"\<WronskianRule\>\"", "\[Rule]", "wronskianRule"}], ",", 
     RowBox[{"\"\<[Q,P]\>\"", "\[Rule]", "canonicalCommutatorCheck"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"c726af64-f8a4-6649-9e07-b0f4ff15d72c"]
