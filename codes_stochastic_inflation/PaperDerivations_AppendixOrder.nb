Cell[CellGroupData[{

Cell["Unitary Bulk-Boundary Entangling", "Subsection",ExpressionUUID->"7be4fe1d-cd29-f147-8f29-c70761c66029"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TQ", "[", 
    RowBox[{"nu_", ",", "sig_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"sig", " ", 
     RowBox[{"HankelH2", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "+", "nu"}], ",", "sig"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["3", "2"], "-", "nu"}], ")"}], " ", 
     RowBox[{"HankelH2", "[", 
      RowBox[{"nu", ",", "sig"}], "]"}]}]}]}], ";", 
  RowBox[{"hankelPhase", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "chi"}], "-", 
     RowBox[{
      FractionBox["1", "4"], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "nu"}], "+", "1"}], ")"}]}]}], "]"}]}], ";", 
  RowBox[{"hankelPhaseBar", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "chi"}], "+", 
     RowBox[{
      FractionBox["1", "4"], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "nuBar"}], "+", "1"}], ")"}]}]}], "]"}]}], ";", 
  RowBox[{"coeffHankelGeneral", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ellQ", "\[Rule]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"hankelPhase", " ", 
         RowBox[{"(", 
          RowBox[{"3", " ", 
           SuperscriptBox["\[Pi]", 
            RowBox[{"3", "/", "2"}]]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sigma", " ", 
            RowBox[{"HankelH2", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], "+", "nu"}], ",", "sigma"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["3", "2"], "-", "nu"}], ")"}], " ", 
            RowBox[{"HankelH2", "[", 
             RowBox[{"nu", ",", "sigma"}], "]"}]}]}], ")"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         SqrtBox["2"], " ", 
         SuperscriptBox["sigma", 
          RowBox[{"3", "/", "2"}]], " ", "Hubble"}], ")"}]}]}], ",", 
     RowBox[{"ellP", "\[Rule]", 
      FractionBox[
       RowBox[{"hankelPhase", " ", 
        RowBox[{"(", 
         RowBox[{"Hubble", " ", 
          SuperscriptBox["sigma", 
           RowBox[{"3", "/", "2"}]]}], ")"}], " ", 
        RowBox[{"HankelH2", "[", 
         RowBox[{"nu", ",", "sigma"}], "]"}]}], 
       RowBox[{"2", " ", 
        SqrtBox[
         RowBox[{"2", " ", "\[Pi]"}]]}]]}], ",", 
     RowBox[{"ellQBar", "\[Rule]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"hankelPhaseBar", " ", 
         RowBox[{"(", 
          RowBox[{"3", " ", 
           SuperscriptBox["\[Pi]", 
            RowBox[{"3", "/", "2"}]]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sigma", " ", 
            RowBox[{"HankelH1", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], "+", "nuBar"}], ",", "sigma"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["3", "2"], "-", "nuBar"}], ")"}], " ", 
            RowBox[{"HankelH1", "[", 
