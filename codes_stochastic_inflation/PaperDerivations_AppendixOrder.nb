Cell[CellGroupData[{

Cell["Stationary covariance and purity", "Subsection",ExpressionUUID->"a3e7d2c8-befe-df42-96bd-89a3b9e6c72d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"dQQ", ",", "dQP", ",", "dPP"}], "]"}], ";", 
  RowBox[{"Dsym", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dQQ", ",", "dQP"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"dQP", ",", "dPP"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"CinfUniversal", "=", 
   RowBox[{"StationaryCovarianceFromD", "[", 
    RowBox[{"mass", ",", "Dsym", ",", 
     RowBox[{"mass", ">", "0"}]}], "]"}]}], ";", 
  RowBox[{"PurityUniversal", "=", 
   RowBox[{"StationaryPurityFromCov", "[", 
    RowBox[{"CinfUniversal", ",", 
     RowBox[{"mass", ">", "0"}]}], "]"}]}], ";", 
  RowBox[{"UniversalLyapunovResidual", "=", 
   RowBox[{"LyapunovResidual", "[", 
    RowBox[{"mass", ",", "Dsym", ",", "CinfUniversal", ",", 
     RowBox[{"mass", ">", "0"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"StationaryData", "[", 
    RowBox[{"name_String", ",", "x_", ",", "rules_", ",", 
     RowBox[{"extra_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", "Dmat", ",", "Cinf", ",", "purity", ",", "eigs"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"A", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"AFromMass", "[", "x", "]"}], ",", 
         RowBox[{"assume", "[", "extra", "]"}]}], "]"}]}], ";", 
      RowBox[{"Dmat", "=", 
       RowBox[{"DFromRules", "[", 
        RowBox[{"rules", ",", "extra"}], "]"}]}], ";", 
      RowBox[{"Cinf", "=", 
       RowBox[{"StationaryCovarianceFromD", "[", 
        RowBox[{"x", ",", "Dmat", ",", "extra"}], "]"}]}], ";", 
      RowBox[{"purity", "=", 
       RowBox[{"StationaryPurityFromCov", "[", 
        RowBox[{"Cinf", ",", "extra"}], "]"}]}], ";", 
      RowBox[{"eigs", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Eigenvalues", "[", "A", "]"}], ",", 
         RowBox[{"assume", "[", "extra", "]"}]}], "]"}]}], ";", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<Regime\>\"", "\[Rule]", "name"}], ",", 
        RowBox[{"\"\<Mass\>\"", "\[Rule]", 
         RowBox[{"Simplify", "[", 
          RowBox[{"x", ",", 
           RowBox[{"assume", "[", "extra", "]"}]}], "]"}]}], ",", 
        RowBox[{"\"\<DriftA\>\"", "\[Rule]", "A"}], ",", 
        RowBox[{"\"\<DriftEigenvalues\>\"", "\[Rule]", "eigs"}], ",", 
        RowBox[{"\"\<DiffusionD\>\"", "\[Rule]", "Dmat"}], ",", 
        RowBox[{"\"\<StationaryCovariance\>\"", "\[Rule]", "Cinf"}], ",", 
        RowBox[{"\"\<StationaryPurity\>\"", "\[Rule]", "purity"}]}], 
       "]"}]}]}], "]"}]}], ";", 
  RowBox[{"generalData", "=", 
   RowBox[{"StationaryData", "[", 
    RowBox[{"\"\<General stable massive Hankel\>\"", ",", "mass", ",", 
     "coeffHankelGeneral", ",", 
     RowBox[{"mass", ">", "0"}]}], "]"}]}], ";", 
  RowBox[{"masslessData", "=", 
   RowBox[{"StationaryData", "[", 
    RowBox[{"\"\<Massless de Sitter\>\"", ",", "0", ",", "coeffMassless", ",",
      "True"}], "]"}]}], ";", 
  RowBox[{"criticalData", "=", 
   RowBox[{"StationaryData", "[", 
    RowBox[{"\"\<Critical: nu = 0, m = 3 H/2\>\"", ",", 
     FractionBox[
      RowBox[{"3", " ", "Hubble"}], "2"], ",", "coeffCritical", ",", "True"}],
     "]"}]}], ";", 
  RowBox[{"heavyData", "=", 
   RowBox[{"StationaryData", "[", 
    RowBox[{"\"\<Heavy/principal: nu = I mu, m = H Sqrt[mu^2 + 9/4]\>\"", ",", 
     RowBox[{"Hubble", " ", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["mu", "2"], "+", 
        FractionBox["9", "4"]}]]}], ",", "coeffHeavy", ",", "True"}], "]"}]}],
   ";", 
  RowBox[{"FPGeneralCollectedD", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", "phiBar", " ", "phiMode"}], "Vcom"], ",", 
       RowBox[{
        FractionBox[
         RowBox[{"3", " ", "\[ImaginaryI]"}], "2"], "+", 
        RowBox[{"3", " ", "phiBar", " ", "piMode"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"3", " ", "\[ImaginaryI]"}], "2"], "+", 
        RowBox[{"3", " ", "phiBar", " ", "piMode"}]}], ",", 
       RowBox[{"3", " ", "piBar", " ", "piMode", " ", "Vcom"}]}], "}"}]}], 
    "}"}]}], ";", 
  RowBox[{"FPGeneralCollectedDWronskian", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"FPGeneralCollectedD", "/.", "\[VeryThinSpace]", 
      RowBox[{"\[ImaginaryI]", "\[Rule]", 
       RowBox[{
        RowBox[{"phiMode", " ", "piBar"}], "-", 
        RowBox[{"phiBar", " ", "piMode"}]}]}]}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"FPGeneralPurity", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"PurityUniversal", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dQQ", "\[Rule]", 
         RowBox[{"FPGeneralCollectedDWronskian", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"dQP", "\[Rule]", 
         RowBox[{"FPGeneralCollectedDWronskian", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"dPP", "\[Rule]", 
         RowBox[{"FPGeneralCollectedDWronskian", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}]}], "}"}]}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"FPGeneralPurityInvSq", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["FPGeneralPurity", "2"]], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"FPGeneralPurityInvSqPaper", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["mass", "2"], " ", 
      SuperscriptBox["Vphys", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["Vcom", "2"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"piBar", " ", "piMode"}], ")"}], "2"]}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["mass", "4"], " ", 
          SuperscriptBox["Vphys", "4"]}], ")"}], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"phiBar", " ", "phiMode"}], ")"}], "2"]}], 
       SuperscriptBox["Vcom", "2"]], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"9", " ", 
          SuperscriptBox["Hubble", "2"]}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["mass", "2"]}]}], ")"}], " ", 
       SuperscriptBox["Vphys", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"phiBar", " ", "phiMode"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"piBar", " ", "piMode"}], ")"}]}], "+", 
      RowBox[{"3", " ", "Hubble", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"phiBar", " ", "piMode"}], "+", 
         RowBox[{"phiMode", " ", "piBar"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Vcom", " ", "Vphys", " ", "piBar", " ", "piMode"}], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["mass", "2"], " ", 
             SuperscriptBox["Vphys", "3"]}], ")"}], " ", "phiBar", " ", 
           "phiMode"}], "Vcom"]}], ")"}]}]}], ")"}]}]}], ";", 
  RowBox[{"FPGeneralPurityPaperCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"FPGeneralPurityInvSq", "-", "FPGeneralPurityInvSqPaper"}], ",", 
     RowBox[{
      RowBox[{"assume", "[", 
       RowBox[{"mass", ">", "0"}], "]"}], "&&", 
      RowBox[{
       RowBox[{
        RowBox[{"phiMode", " ", "piBar"}], "-", 
        RowBox[{"phiBar", " ", "piMode"}]}], "\[Equal]", 
       "\[ImaginaryI]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"afe31ed2-3212-5249-aa22-1651c492bd6d"],

Cell["Critical stationary purity limit", "Subsubsection"],

Cell[BoxData["\<\
ClearAll[critX, critS, critZ, critR, critY, CriticalSigmaFromD,
  CriticalPurityDetBeforeWronskian, CriticalPurityDet,
  CriticalPurityExactReduced, CriticalPurityExact, CriticalPurityLimit,
  CriticalPurityCheck];

CriticalSigmaFromD = {
  {5 dQQ/6 + 4 dQP/(9 Hubble Vphys) +
    2 dPP/(27 Hubble^2 Vphys^2), -Hubble Vphys dQQ/2},
  {-Hubble Vphys dQQ/2, dPP/6 + 3 Hubble^2 Vphys^2 dQQ/8}
};

critR = (3 critX/2) - sigma critS;
critY = (9 critX/4) - 3 sigma critS + sigma^2 critZ;

CriticalPurityDetBeforeWronskian = FullSimplify[
  Det[CriticalSigmaFromD] /. {
    Vphys -> 6 Pi^2/(Hubble^3 sigma^3),
    dQQ -> Hubble^2 sigma^3 critX/(8 Pi),
    dQP -> -(3 Pi/4) critR,
    dPP -> 9 Pi^3 critY/(2 Hubble^2 sigma^3)
  },
  Hubble > 0 && sigma > 0 && critX > 0 &&
    Element[{critS, critZ}, Reals]
];

CriticalPurityDet = FullSimplify[
  CriticalPurityDetBeforeWronskian /.
    critZ -> (critS^2 + 4/(Pi^2 sigma^2))/critX,
  Hubble > 0 && sigma > 0 && critX > 0 && Element[critS, Reals]
];

CriticalPurityExactReduced = FullSimplify[
  1/(2 Sqrt[CriticalPurityDet]),
  sigma > 0 && critX > 0 && Element[critS, Reals]
];

CriticalPurityExact = CriticalPurityExactReduced /. {
  critX -> BesselJ[0, sigma]^2 + BesselY[0, sigma]^2,
  critS -> BesselJ[0, sigma] BesselJ[1, sigma] +
    BesselY[0, sigma] BesselY[1, sigma]
};

CriticalPurityLimit =
  Limit[CriticalPurityExact, sigma -> 0, Direction -> \"FromAbove\"];

CriticalPurityCheck =
  FullSimplify[CriticalPurityLimit - 3 Pi/Sqrt[4 + 9 Pi^2]];
\>"], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Massless shell noise with a massive restoring drift", "Subsection",ExpressionUUID->"6482915f-fb6a-3e48-9e2e-195d218d8b9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DMasslessFPConvention", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["Hubble", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SuperscriptBox["sigma", "2"]}], ")"}]}], 
        RowBox[{"4", " ", 
         SuperscriptBox["\[Pi]", "2"]}]], ",", 
       RowBox[{"-", 
        FractionBox["3", 
         RowBox[{"2", " ", "sigma"}]]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["3", 
         RowBox[{"2", " ", "sigma"}]]}], ",", 
       FractionBox[
        RowBox[{"9", " ", 
         SuperscriptBox["\[Pi]", "2"]}], 
        RowBox[{
         SuperscriptBox["Hubble", "2"], " ", 
         SuperscriptBox["sigma", "2"]}]]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"DMasslessFlippedSign", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["Hubble", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SuperscriptBox["sigma", "2"]}], ")"}]}], 
        RowBox[{"4", " ", 
         SuperscriptBox["\[Pi]", "2"]}]], ",", 
       FractionBox["3", 
        RowBox[{"2", " ", "sigma"}]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["3", 
        RowBox[{"2", " ", "sigma"}]], ",", 
       FractionBox[
        RowBox[{"9", " ", 
         SuperscriptBox["\[Pi]", "2"]}], 
        RowBox[{
         SuperscriptBox["Hubble", "2"], " ", 
         SuperscriptBox["sigma", "2"]}]]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"CRegulatedUsingFPD", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"StationaryCovarianceFromD", "[", 
       RowBox[{"mass", ",", "DMasslessFPConvention"}], "]"}], "/.", 
      "\[VeryThinSpace]", "VphysShellRule"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"CRegulatedUsingCovSignD", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"StationaryCovarianceFromD", "[", 
       RowBox[{"mass", ",", "DMasslessFlippedSign"}], "]"}], "/.", 
      "\[VeryThinSpace]", "VphysShellRule"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"PaperRegulatedCovariance", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["Hubble", "2"], " ", 
          SuperscriptBox["mass", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["sigma", "2"]}], ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["Hubble", "4"], " ", 
          RowBox[{"(", 
           RowBox[{"9", "+", 
            RowBox[{"3", " ", 
             SuperscriptBox["sigma", "2"]}], "+", 
            SuperscriptBox["sigma", "4"]}], ")"}]}]}], 
        RowBox[{"24", " ", 
         SuperscriptBox["mass", "2"], " ", 
         SuperscriptBox["\[Pi]", "2"]}]], ",", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"3", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["sigma", "2"]}], ")"}]}], 
         RowBox[{"4", " ", 
          SuperscriptBox["sigma", "3"]}]]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"3", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["sigma", "2"]}], ")"}]}], 
         RowBox[{"4", " ", 
          SuperscriptBox["sigma", "3"]}]]}], ",", 
       FractionBox[
        RowBox[{"3", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["Hubble", "2"], " ", 
            SuperscriptBox["sigma", "4"]}], "+", 
           RowBox[{
            SuperscriptBox["mass", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SuperscriptBox["sigma", "2"]}], ")"}]}]}], ")"}]}], 
        RowBox[{"2", " ", 
         SuperscriptBox["Hubble", "4"], " ", 
         SuperscriptBox["sigma", "6"]}]]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"MasslessRegulatorCovarianceChecks", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<Using FP D_QP = -3/(2 sigma)\>\"", "\[Rule]", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"CRegulatedUsingFPD", "-", "PaperRegulatedCovariance"}], ",", 
        RowBox[{"assume", "[", 
         RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Using flipped-sign D_QP = +3/(2 sigma)\>\"", "\[Rule]", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"CRegulatedUsingCovSignD", "-", "PaperRegulatedCovariance"}], 
        ",", 
        RowBox[{"assume", "[", 
         RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{"MasslessRegulatorLyapunovResidual", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"AFromMass", "[", "mass", "]"}], "/.", "\[VeryThinSpace]", 
         "VphysShellRule"}], ")"}], ".", "PaperRegulatedCovariance"}], "+", 
      RowBox[{"PaperRegulatedCovariance", ".", 
       TemplateBox[{
         RowBox[{"(", 
           RowBox[{
             RowBox[{"AFromMass", "[", "mass", "]"}], "/.", 
             "\[VeryThinSpace]", "VphysShellRule"}], ")"}]},
        "Transpose"]}], "+", "DMasslessFPConvention"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"DetRegulated", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Det", "[", "PaperRegulatedCovariance", "]"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"PurityRegulated", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", " ", 
       SqrtBox["DetRegulated"]}]], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"MasslessLimitRegulatedPurity", "=", 
   RowBox[{
    UnderscriptBox["\[Limit]", 
     TagBox[
      RowBox[{"mass", "\[Rule]", 
       SuperscriptBox["0", "+"]}],
      "AlternateLimitDirection"]], "PurityRegulated"}]}], ";"}]], "Input",
 CellLabel->"In[74]:=",ExpressionUUID->"79d1566c-2c2a-cc4f-94e0-548df209a3e8"]
