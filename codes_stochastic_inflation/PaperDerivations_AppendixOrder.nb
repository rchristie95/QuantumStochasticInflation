Cell[CellGroupData[{

Cell["Bulk-Boundary Differential Relations", "Subsection",ExpressionUUID->"02e02bd3-b247-7040-af2e-87abbe9cfe5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coeffModeFunctions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ellQ", "\[Rule]", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox[
         RowBox[{"3", " ", "Vcom"}]]}], " ", "piBar"}]}], ",", 
     RowBox[{"ellP", "\[Rule]", 
      RowBox[{
       SqrtBox[
        FractionBox["3", "Vcom"]], " ", "phiBar"}]}], ",", 
     RowBox[{"ellQBar", "\[Rule]", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox[
         RowBox[{"3", " ", "Vcom"}]]}], " ", "piMode"}]}], ",", 
     RowBox[{"ellPBar", "\[Rule]", 
      RowBox[{
       SqrtBox[
        FractionBox["3", "Vcom"]], " ", "phiMode"}]}]}], "}"}]}], ";", 
  RowBox[{"VcomToPhysicalRule", "=", 
   RowBox[{"Vcom", "\[Rule]", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "3"}], " ", "N"}], "]"}], " ", "Vphys"}]}]}], ";", 
  RowBox[{"DGeneralModeFunctions", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DFromRules", "[", "coeffModeFunctions", "]"}], "/.", 
      "\[VeryThinSpace]", "VcomToPhysicalRule"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"Vphys", ">", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"FPConventionGeneral", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<DQQ\>\"", "\[Rule]", 
      RowBox[{"DGeneralModeFunctions", "\[LeftDoubleBracket]", 
