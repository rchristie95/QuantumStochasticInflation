                RowBox[{"2", ",", "0"}], ")"}],
               Derivative],
              MultilineFunction->None], "[", 
             RowBox[{"q", ",", "p"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"Coefficient", "[", 
          RowBox[{"expr", ",", 
           RowBox[{
            SuperscriptBox["W", 
             TagBox[
              RowBox[{"(", 
               RowBox[{"1", ",", "1"}], ")"}],
              Derivative],
             MultilineFunction->None], "[", 
            RowBox[{"q", ",", "p"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
