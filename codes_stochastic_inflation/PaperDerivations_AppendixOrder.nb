   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"KossakowskiMassless", " ", "-", " ", 
      RowBox[{"ConjugateTranspose", "[", "KossakowskiMassless", "]"}]}], ",", 
     " ", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
