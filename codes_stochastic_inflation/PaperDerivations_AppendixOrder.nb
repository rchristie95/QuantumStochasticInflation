   "K0", ",", "K1", ",", "K0dag", ",", "K1dag", ",", "PiBlock", ",", "dY", ",",
     "dYstar", ",", "dY1", ",", "dY2", ",", "dW", ",", "dW1", ",", "dW2", ",",
     "p0Y", ",", "p0Het", ",", "z", ",", "zbar"}], "]"}], ";", 
  RowBox[{"K0", "=", 
   RowBox[{"Id", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "Kop"}], "+", 
       FractionBox[
        RowBox[{"Ldag", "**", "Lop"}], "2"]}], ")"}], " ", "dN"}]}]}], ";", 
  RowBox[{"K0dag", "=", 
   RowBox[{"Id", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "Kop"}], "-", 
       FractionBox[
        RowBox[{"Ldag", "**", "Lop"}], "2"]}], ")"}], " ", "dN"}]}]}], ";", 
  RowBox[{"K1", "=", 
   RowBox[{
    RowBox[{"-", 
     SqrtBox["dN"]}], " ", "Lop"}]}], ";", 
  RowBox[{"K1dag", "=", 
   RowBox[{
    RowBox[{"-", 
     SqrtBox["dN"]}], " ", "Ldag"}]}], ";", 
  RowBox[{"FullBlockRJ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"K0", "**", "rho", "**", "K0dag"}], ",", 
       RowBox[{"K0", "**", "rho", "**", "K1dag"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"K1", "**", "rho", "**", "K0dag"}], ",", 
       RowBox[{"K1", "**", "rho", "**", "K1dag"}]}], "}"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"InstrumentFromPOVM", "[", "PiBlock_", "]"}], ":=", 
