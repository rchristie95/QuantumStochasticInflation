    RowBox[{"collectW", "[", 
     RowBox[{
     "LindGenericFP", "/.", "\[VeryThinSpace]", "coeffModeFunctions"}], "]"}],
     "]"}]}], ";", 
  RowBox[{"FPGeneralExpected", "=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"6", " ", 
       RowBox[{"W", "[", 
