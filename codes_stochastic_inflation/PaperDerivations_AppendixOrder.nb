Notebook[{

Cell[CellGroupData[{
Cell["Paper Derivations in Appendix Order", "Title",ExpressionUUID->"50890684-ee12-0f4f-ad2f-fce73af9b8fd"],

Cell["\<\
This notebook collects the symbolic checks and derivations used by the paper, \
organized to follow the appendix order of NewCopy.tex. It intentionally \
contains input cells only; evaluate cells manually from top to bottom when \
you want to reproduce outputs.\
\>", "Text",ExpressionUUID->"c2e93862-9ca9-c94a-9ee7-f1f0036d6db4"],

Cell["\<\
Source notebooks/text summaries folded in here: GKLSVsFokkerPlanck.nb / \
GKLSDeterminant.txt, MoyalLindbladToFokkerPlanck.nb / .txt, \
StationaryPurityAllRegimes.nb / .txt, plus added POVM/Gaussian-readout checks \
not present as a separate notebook.\
\>", "Text",ExpressionUUID->"6f29a046-d753-f048-ad77-5fc012950b7b"],

Cell[CellGroupData[{

Cell["Global Setup and Shared Notation", "Section",ExpressionUUID->"ce4f6671-59c3-0349-a8b7-d3cbfad3bb35"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
  RowBox[{"modeAssums", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Hubble", ">", "0"}], ",", 
     RowBox[{"sigma", ">", "0"}], ",", 
     RowBox[{"Vphys", ">", "0"}], ",", 
     RowBox[{"Vcom", ">", "0"}], ",", 
     RowBox[{"mu", ">", "0"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "q", ",", "p", ",", "Hubble", ",", "sigma", ",", "Vphys", ",", "Vcom", 
        ",", "mass", ",", "m", ",", "mu", ",", "chi", ",", "N", ",", 
        "DeltaQQ", ",", "DeltaQP", ",", "DeltaPP", ",", "sxx", ",", "sxp", ",",
         "spp", ",", "dQQ", ",", "dQP", ",", "dPP"}], "}"}], "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"assume", "[", 
    RowBox[{"extra_", ":", "True"}], "]"}], ":=", 
   RowBox[{"And", "@@", 
    RowBox[{"Join", "[", 
     RowBox[{"modeAssums", ",", 
      RowBox[{"{", "extra", "}"}]}], "]"}]}]}], ";", 
  RowBox[{"Omega", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"Z", "=", 
   RowBox[{"{", 
    RowBox[{"q", ",", "p"}], "}"}]}], ";", 
  RowBox[{"SigmaC", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"DeltaQQ", ",", "DeltaQP"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"DeltaQP", ",", "DeltaPP"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"SigmaSym", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sxx", ",", "sxp"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"sxp", ",", "spp"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"KeffWeyl", "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["p", "2"], 
     RowBox[{"2", " ", "Hubble", " ", "Vphys"}]], "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["mass", "2"], " ", "Vphys"}], ")"}], " ", 
      SuperscriptBox["q", "2"]}], 
     RowBox[{"2", " ", "Hubble"}]], "+", 
    FractionBox[
     RowBox[{"3", " ", "q", " ", "p"}], "2"]}]}], ";", 
  RowBox[{"alpha", ":=", 
   FractionBox["1", 
    RowBox[{"Hubble", " ", "Vphys"}]]}], ";", 
  RowBox[{
   RowBox[{"betaFromMass", "[", "x_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["x", "2"], " ", "Vphys"}], "Hubble"]}], ";", 
  RowBox[{
   RowBox[{"AFromMass", "[", "x_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "alpha"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"betaFromMass", "[", "x", "]"}]}], ",", 
       RowBox[{"-", "3"}]}], "}"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"DFromEll", "[", 
    RowBox[{"ellQv_", ",", "ellPv_", ",", "ellQbv_", ",", "ellPbv_", ",", 
     RowBox[{"extra_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ellPv", " ", "ellPbv"}], ",", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ellQv", " ", "ellPbv"}], "+", 
            RowBox[{"ellQbv", " ", "ellPv"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ellQv", " ", "ellPbv"}], "+", 
            RowBox[{"ellQbv", " ", "ellPv"}]}], ")"}]}], ",", 
         RowBox[{"ellQv", " ", "ellQbv"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"assume", "[", "extra", "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"DFromRules", "[", 
    RowBox[{"rules_", ",", 
     RowBox[{"extra_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"DFromEll", "[", 
    RowBox[{
     RowBox[{"ellQ", "/.", "\[VeryThinSpace]", "rules"}], ",", 
     RowBox[{"ellP", "/.", "\[VeryThinSpace]", "rules"}], ",", 
     RowBox[{"ellQBar", "/.", "\[VeryThinSpace]", "rules"}], ",", 
     RowBox[{"ellPBar", "/.", "\[VeryThinSpace]", "rules"}], ",", "extra"}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"StationaryCovarianceFromD", "[", 
    RowBox[{"x_", ",", "Dmat_", ",", 
     RowBox[{"extra_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "a", ",", "b", ",", "c", ",", "beta", ",", "y", ",", "z", ",", "xx"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Dmat", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"Dmat", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"Dmat", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}]}], ";", 
      RowBox[{"beta", "=", 
       RowBox[{"betaFromMass", "[", "x", "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"beta", "\[Equal]", "0"}], ",", 
           RowBox[{"assume", "[", "extra", "]"}]}], "]"}], "]"}], ",", 
        RowBox[{"Missing", "[", "\"\<NoFiniteStationaryCovariance\>\"", "]"}],
         ",", 
        RowBox[{
         RowBox[{"y", "=", 
          RowBox[{"-", 
           FractionBox["a", 
            RowBox[{"2", " ", "alpha"}]]}]}], ";", 
         RowBox[{"z", "=", 
          RowBox[{
           FractionBox["1", "6"], " ", 
           RowBox[{"(", 
            RowBox[{"c", "+", 
             FractionBox[
              RowBox[{"beta", " ", "a"}], "alpha"]}], ")"}]}]}], ";", 
         RowBox[{"xx", "=", 
          FractionBox[
           RowBox[{
            RowBox[{"alpha", " ", "z"}], "+", 
            FractionBox[
             RowBox[{"3", " ", "a"}], 
             RowBox[{"2", " ", "alpha"}]], "+", "b"}], "beta"]}], ";", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xx", ",", "y"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "z"}], "}"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"assume", "[", "extra", "]"}], "&&", 
            RowBox[{"beta", ">", "0"}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"StationaryPurityFromCov", "[", 
    RowBox[{"Cmat_", ",", 
     RowBox[{"extra_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Head", "[", "Cmat", "]"}], "===", "Missing"}], ",", 
     RowBox[{"Missing", "[", "\"\<NoFiniteStationaryPurity\>\"", "]"}], ",", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", " ", 
         SqrtBox[
          RowBox[{"Det", "[", "Cmat", "]"}]]}]], ",", 
       RowBox[{"assume", "[", "extra", "]"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"LyapunovResidual", "[", 
    RowBox[{"x_", ",", "Dmat_", ",", "Cmat_", ",", 
     RowBox[{"extra_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Head", "[", "Cmat", "]"}], "===", "Missing"}], ",", 
     RowBox[{"Missing", "[", "\"\<NoFiniteStationaryCovariance\>\"", "]"}], ",", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"AFromMass", "[", "x", "]"}], ".", "Cmat"}], "+", 
        RowBox[{"Cmat", ".", 
         TemplateBox[{
           RowBox[{"AFromMass", "[", "x", "]"}]},
          "Transpose"]}], "+", "Dmat"}], ",", 
       RowBox[{"assume", "[", "extra", "]"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"VphysShellRule", "=", 
   RowBox[{"Vphys", "\[Rule]", 
    FractionBox[
     RowBox[{"6", " ", 
      SuperscriptBox["\[Pi]", "2"]}], 
     RowBox[{
      SuperscriptBox["Hubble", "3"], " ", 
      SuperscriptBox["sigma", "3"]}]]}]}], ";"}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"429d799a-9cb9-da4f-a55b-0f72b8b7b594"]
}, Open  ]],

