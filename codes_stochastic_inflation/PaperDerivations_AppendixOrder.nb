    RowBox[{"3", " ", "p", " ", 
     RowBox[{
      SuperscriptBox["W", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "1"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"q", ",", "p"}], "]"}]}], "-", 
    FractionBox[
     RowBox[{"p", " ", 
      RowBox[{
       SuperscriptBox["W", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"q", ",", "p"}], "]"}]}], 
     RowBox[{"Hubble", " ", "Vphys"}]], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["Hubble", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["sigma", "2"]}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["W", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"2", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"q", ",", "p"}], "]"}]}], 
     RowBox[{"8", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], "-", 
    FractionBox[
     RowBox[{"3", " ", 
      RowBox[{
       SuperscriptBox["W", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"q", ",", "p"}], "]"}]}], 
     RowBox[{"2", " ", "sigma"}]], "+", 
    FractionBox[
     RowBox[{"9", " ", 
      SuperscriptBox["\[Pi]", "2"], " ", 
      RowBox[{
       SuperscriptBox["W", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "2"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"q", ",", "p"}], "]"}]}], 
     RowBox[{"2", " ", 
      SuperscriptBox["Hubble", "2"], " ", 
      SuperscriptBox["sigma", "2"]}]]}]}], ";", 
  RowBox[{"FPMasslessCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"FPMassless", "-", "FPMasslessExpected"}], ",", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";", 
  RowBox[{"FPMasslessDiffusionCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DiffusionFromGenerator", "[", "FPMassless", "]"}], "-", 
      "DMasslessExpected"}], ",", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";", 
  RowBox[{"DQQLightLeading", "=", 
