    RowBox[{"first", ",", " ", "tail"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NonCommutativeMultiply", "[", 
    RowBox[{"first___", ",", " ", 
     RowBox[{
      RowBox[{"s_", "?", "ncScalarQ"}], " ", "*", " ", "rest_"}], ",", " ", 
     "tail___"}], "]"}], " ", ":=", " ", 
   RowBox[{"s", " ", "*", " ", 
    RowBox[{"NonCommutativeMultiply", "[", 
     RowBox[{"first", ",", " ", "rest", ",", " ", "tail"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NonCommutativeMultiply", "[", 
    RowBox[{"first___", ",", " ", 
     RowBox[{"s_", "?", "ncScalarQ"}], ",", " ", "tail___"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"s", " ", "*", " ", 
    RowBox[{"NonCommutativeMultiply", "[", 
     RowBox[{"first", ",", " ", "tail"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"NonCommutativeMultiply", ",", " ", "Flat"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u_", " ", "**", " ", 
    RowBox[{"(", 
     RowBox[{"v_", " ", "+", " ", "w_"}], ")"}]}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"u", " ", "**", " ", "v"}], " ", "+", " ", 
    RowBox[{"u", " ", "**", " ", "w"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"v_", " ", "+", " ", "w_"}], ")"}], " ", "**", " ", "u_"}], " ", 
   ":=", " ", 
   RowBox[{
    RowBox[{"v", " ", "**", " ", "u"}], " ", "+", " ", 
    RowBox[{"w", " ", "**", " ", "u"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Protect", "[", "NonCommutativeMultiply", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"comm", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"a", " ", "**", " ", "b"}], " ", "-", " ", 
    RowBox[{"b", " ", "**", " ", "a"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"anti", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
