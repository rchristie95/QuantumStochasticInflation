Cell["Tracing out the boundary", "Subsection",ExpressionUUID->"384f47d0-67ca-614b-b948-10c3726e789e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Unprotect", "[", "NonCommutativeMultiply", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "NonCommutativeMultiply", ",", " ", "ncScalarQ", ",", " ", "comm", ",", 
    " ", "anti", ",", " ", "Dsuper", ",", " ", "rho", ",", " ", "Lop", ",", 
    " ", "Ldag", ",", " ", "Kop", ",", " ", "Id", ",", " ", "dN"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NonCommutativeMultiply", "[", "]"}], " ", ":=", " ", "1"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NonCommutativeMultiply", "[", "a_", "]"}], " ", ":=", " ", "a"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ncScalarQ", "[", "expr_", "]"}], " ", ":=", " ", 
