Cell[CellGroupData[{

Cell["Gaussian dynamics for the heterodyne readout", "Subsubsection",ExpressionUUID->"c449d2a3-f9f6-6d47-ba6b-33849ffe9ccc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nHet1", "[", 
    RowBox[{"ellVec_", ",", "cov_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"cov", ".", 
         RowBox[{"Re", "[", "ellVec", "]"}]}]}], "-", 
       RowBox[{"Omega", ".", 
        RowBox[{"Im", "[", "ellVec", "]"}]}]}], 
      SqrtBox["2"]], ",", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"nHet2", "[", 
    RowBox[{"ellVec_", ",", "cov_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"cov", ".", 
         RowBox[{"Im", "[", "ellVec", "]"}]}]}], "+", 
       RowBox[{"Omega", ".", 
        RowBox[{"Re", "[", "ellVec", "]"}]}]}], 
