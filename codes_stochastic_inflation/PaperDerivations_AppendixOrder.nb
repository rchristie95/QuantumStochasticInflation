Cell[CellGroupData[{

Cell["Bulk Part of the Bulk-Boundary Dynamics", "Subsection",ExpressionUUID->"6e7930cd-235c-2747-bed0-cdffab67153d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"HamiltonianDrift", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "p"], "KeffWeyl"}], ",", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "q"], "KeffWeyl"}]}]}], "}"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", "\[GreaterEqual]", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"DissipativeLinearDrift", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"3", " ", "q"}], "2"]}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"3", " ", "p"}], "2"]}]}], "}"}]}], ";", 
  RowBox[{"FullFirstMomentDrift", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"HamiltonianDrift", "+", "DissipativeLinearDrift"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", "\[GreaterEqual]", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"FullDriftMatrixCheck", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"FullFirstMomentDrift", "-", 
      RowBox[{
       RowBox[{"AFromMass", "[", "mass", "]"}], ".", "Z"}]}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", "\[GreaterEqual]", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<HamiltonianDrift\>\"", "\[Rule]", "HamiltonianDrift"}], ",", 
    RowBox[{"\"\<DissipativeLinearDrift\>\"", "\[Rule]", 
     "DissipativeLinearDrift"}], ",", 
    RowBox[{"\"\<FullFirstMomentDrift\>\"", "\[Rule]", 
     "FullFirstMomentDrift"}], ",", 
    RowBox[{"\"\<FullDriftMatrixCheck\>\"", "\[Rule]", 
     "FullDriftMatrixCheck"}]}], "]"}]}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"c20c49d7-37be-be42-bc41-0188ec9608fd"],

