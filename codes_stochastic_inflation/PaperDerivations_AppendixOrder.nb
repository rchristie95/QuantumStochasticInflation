Cell["Heterodyne, or two-component, unravelling", "Subsection",ExpressionUUID->"9926f470-47ec-0340-a008-7afa9053e216"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CoherentTruncated01", "[", 
    RowBox[{"zv_", ",", "zbv_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "zv"}], "}"}]}], ";", 
  RowBox[{"CoherentPOVM01", "=", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", 
     RowBox[{"CoherentTruncated01", "[", 
      RowBox[{"z", ",", "zbar"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "zbar"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"HeterodynePOVMFromCoherentState", "=", 
   RowBox[{"CoherentPOVM01", "/.", "\[VeryThinSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"z", "\[Rule]", 
       RowBox[{"-", 
        FractionBox["dY", 
         SqrtBox["dN"]]}]}], ",", 
      RowBox[{"zbar", "\[Rule]", 
       RowBox[{"-", 
        FractionBox["dYstar", 
         SqrtBox["dN"]]}]}]}], "}"}]}]}], ";", 
  RowBox[{"PiHeterodyne", "=", 
   RowBox[{"p0Het", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", 
         FractionBox["dYstar", 
          SqrtBox["dN"]]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["dY", 
          SqrtBox["dN"]]}], ",", 
        FractionBox[
         RowBox[{"dY", " ", "dYstar"}], "dN"]}], "}"}]}], "}"}]}]}], ";", 
  RowBox[{"heterodyneTopLeftCheck", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"HeterodynePOVMFromCoherentState", "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]", "1"}], 
    "]"}]}], ";", 
  RowBox[{"MHet", "=", 
   RowBox[{
    SqrtBox["p0Het"], " ", 
    RowBox[{"(", 
     RowBox[{"Id", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "Kop"}], "+", 
         FractionBox[
          RowBox[{"Ldag", "**", "Lop"}], "2"]}], ")"}], " ", "dN"}], "+", 
      RowBox[{"Lop", " ", "dYstar"}]}], ")"}]}]}], ";", 
  RowBox[{"HeterodyneInstrumentContracted", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"InstrumentFromPOVM", "[", "PiHeterodyne", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"dN", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"dYComplexRule", "=", 
   RowBox[{"dY", "\[Rule]", 
    FractionBox[
     RowBox[{"dY1", "+", 
      RowBox[{"\[ImaginaryI]", " ", "dY2"}]}], 
     SqrtBox["2"]]}]}], ";", 
  RowBox[{"dYStarRule", "=", 
   RowBox[{"dYstar", "\[Rule]", 
    FractionBox[
     RowBox[{"dY1", "-", 
      RowBox[{"\[ImaginaryI]", " ", "dY2"}]}], 
     SqrtBox["2"]]}]}], ";"}]], "Input",
