     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";", 
  RowBox[{"ellMasslessVector", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", "3", " ", "\[Pi]"}], 
       RowBox[{"sigma", " ", "Hubble"}]]}], ",", 
     FractionBox[
      RowBox[{"Hubble", " ", 
       RowBox[{"(", 
        RowBox[{"sigma", "-", "\[ImaginaryI]"}], ")"}]}], 
      RowBox[{"2", " ", "\[Pi]"}]]}], "}"}]}], ";", 
  RowBox[{"nHetMassless", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nHet1", "[", 
        RowBox[{"ellMasslessVector", ",", "SigmaC"}], "]"}], ",", 
       RowBox[{"nHet2", "[", 
        RowBox[{"ellMasslessVector", ",", "SigmaC"}], "]"}]}], "}"}], ",", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";", 
  RowBox[{"nHetMasslessExpected", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"Hubble", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "sigma", " ", "DeltaQP"}]}], ")"}]}], 
        RowBox[{"2", " ", 
         SqrtBox["2"], " ", "\[Pi]"}]], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"3", " ", "\[Pi]"}], 
           RowBox[{"Hubble", " ", "sigma"}]]}], "+", 
         FractionBox[
          RowBox[{"Hubble", " ", "sigma", " ", "DeltaPP"}], "\[Pi]"]}], 
        SqrtBox["2"]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{
         FractionBox[
          RowBox[{"Hubble", " ", "sigma"}], 
          RowBox[{"2", " ", "\[Pi]"}]], "-", 
         FractionBox[
          RowBox[{"Hubble", " ", "DeltaQP"}], "\[Pi]"], "-", 
         FractionBox[
          RowBox[{"6", " ", "\[Pi]", " ", "DeltaQQ"}], 
          RowBox[{"Hubble", " ", "sigma"}]]}], 
        SqrtBox["2"]], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"Hubble", " ", "DeltaPP"}], "\[Pi]"]}], "-", 
         FractionBox[
          RowBox[{"6", " ", "\[Pi]", " ", "DeltaQP"}], 
          RowBox[{"Hubble", " ", "sigma"}]]}], 
        SqrtBox["2"]]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"heterodyneMasslessNoiseCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"nHetMassless", "-", "nHetMasslessExpected"}], ",", 
     RowBox[{"assume", "[", "True", "]"}]}], "]"}]}], ";", 
  RowBox[{"DUnconditionalMassless", "=", 
   RowBox[{"DFromRules", "[", "coeffMassless", "]"}]}], ";", 
  RowBox[{"RiccatiMassless", "=", 
