           RowBox[{"1", ",", "1"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"q", ",", "p"}], "]"}], ",", 
       RowBox[{
        SuperscriptBox["W", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "2"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"q", ",", "p"}], "]"}]}], "}"}], ",", "Simplify"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"useWronskian", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "wr", "}"}], ",", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"expr", "/.", "\[VeryThinSpace]", 
            RowBox[{
             RowBox[{"phiMode", " ", "piBar"}], "\[Rule]", 
             RowBox[{"wr", "+", 
              RowBox[{"phiBar", " ", "piMode"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"wr", ",", 
            RowBox[{"phiBar", " ", "piMode"}], ",", 
            RowBox[{"phiBar", " ", "phiMode"}], ",", 
            RowBox[{"piBar", " ", "piMode"}]}], "}"}], ",", "Simplify"}], 
         "]"}], "/.", "\[VeryThinSpace]", 
        RowBox[{"wr", "\[Rule]", "\[ImaginaryI]"}]}], ",", 
       RowBox[{"assume", "[", 
        RowBox[{"mass", "\[GreaterEqual]", "0"}], "]"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"LindGenericLong", "=", 
   RowBox[{"collectW", "[", 
    RowBox[{"LindbladGenerator", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "moyalOrder"}], "]"}], "]"}]}], ";", 
  RowBox[{"LindGenericFP", "=", 
   RowBox[{"collectW", "[", 
    RowBox[{"LindbladGenerator", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "2"}], "]"}], "]"}]}], ";", 
  RowBox[{"HigherMoyalCorrection", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"LindGenericLong", "-", "LindGenericFP"}], ",", 
     RowBox[{"assume", "[", 
      RowBox[{"mass", "\[GreaterEqual]", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"FPGeneralModeFunctions", "=", 
